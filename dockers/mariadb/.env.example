# ==========================================
# MariaDB Configuration
# ==========================================

# Mật khẩu cho tài khoản root (quản trị viên tối cao)
MARIADB_ROOT_PASSWORD=RootPassword123!

# Tên cơ sở dữ liệu (database) sẽ được tạo tự động khi khởi động lần đầu
MARIADB_DATABASE=app_database

# Tên người dùng (user) thông thường để ứng dụng kết nối vào database
MARIADB_USER=app_user

# Mật khẩu cho người dùng thông thường ở trên
MARIADB_PASSWORD=AppPassword123!
