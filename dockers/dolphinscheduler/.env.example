# Phiên bản của DolphinScheduler (Anh có thể thay bằng 3.2.1, 3.2.2, hoặc latest)
DOLPHINSCHEDULER_VERSION=latest

# Cấu hình Port
# 12345: Cổng giao diện Web UI và API
DS_WEB_PORT=12345
# 25333: Cổng giao tiếp nội bộ gRPC (Master/Worker)
DS_GRPC_PORT=25333

# (Tùy chọn) Đường dẫn lưu trữ dữ liệu và logs để không bị mất khi restart container
DS_DATA_DIR=./dolphinscheduler_data