# ==========================================
# Cấu hình PostgreSQL Backend cho Grafana
# ==========================================
# Nếu PostgreSQL chạy trên máy host (máy thật), giữ nguyên là host.docker.internal
# Nếu PostgreSQL chạy trong cùng file docker-compose.yml, hãy đổi thành tên service (ví dụ: postgres)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=grafana_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==========================================
# Cấu hình tài khoản Admin cho Grafana
# ==========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
